// Connor S. Murray, PhD
// Bioinformatician, Univ. of Louisville SOM
// Started: 12.17.2025; 02.17.2026; 03.09.2026; 05.05.2026
// A nextflow pipeline for simulating PacBio HiFi reads and detecting HIV/SIV/AAV viral integrations
//

// Paramters for pipeline
params {

    help = false

    // Input genomes (All necessary!)
    host_genome = null
    viral_genomes = "${projectDir}/data/hiv_genome_panel_broad/*fasta"
    annotation = null    // Optional annotation file: GTF, GFF3, or GFF (plain or .gz)

    // Patient samples (set to skip simulation)
    samples = null
    patient_dir = null
    patient_bam = null
    patient_fastq = null

    // Competetive mapping
    max_iterations = 3
    trim_begin = 0
    trim_end = 0

    // Integration parameters (If running simulation)
    n_integrations = 10
    target_chroms = null
    seed = null

    // Simulation (pbsim3) parameters
    depth = 30
    min_mapq = 30
    length_mean = 15000
    accuracy_mean = 0.99
    pbsim_model = "/opt/pbsim3/data/QSHMM-RSII.model" // This is within the apptainer image

    // Working Directory
    workDir = "${projectDir}/work"

    // Output
    outdir = "${projectDir}/output"
    run_name = null // Optional display name used in the HTML report

    // SLURM Default
    partition = 'cpu384g'   // default partition for most jobs
    partition_large = 'cpu384g'  // large-memory partition for multi-mapping
    threads = 8
    memory = '4 GB'

    // Containers (If downloaded locally - we reccommend this!)
    // container = '/home/c0murr09/sifs/viral_int3.sif'
    container_R = '/work/c0murr09/sifs/viral_intR4.sif'

    container = 'library://connmurr243/connmurr_viral/viral_int.sif:latest'
    //container_R = 'library://connmurr243/connmurrviral/viralint-r3:latest'

    // Bypass lima entirely; treat every samplesheet row as already demultiplexed regardless of its `demux` column.
    skip_demux = false

    // Fallback barcode FASTA used when a row sets `demux=true` but omits
    // its own `barcode_fasta`. Leave null to require per-row paths.
    default_barcode_fasta   = null

    // Pass-through args for `lima` (ext.args via the process directive
    // block below). Common HiFi presets:
    //   --hifi-preset SYMMETRIC   (PacBio HiFi symmetric barcodes)
    //   --hifi-preset ASYMMETRIC
    //   --min-score 80            (typical for HiFi)
    //   --peek-guess              (auto-detect barcodes when uncertain)
    lima_args = "--hifi-preset SYMMETRIC --min-score 80"

    // ====================================================================
    // REFACTOR ADDITIONS — clonal-ID assignment (assign_clonal_ids.R)
    // ====================================================================
    // Window in bp within which integrations on the same chromosome are
    // collapsed into a single clone. ±10 bp is appropriate for HiFi
    // breakpoints; raise if you observe wider scatter.
    clonal_window_bp = 10

    // Require same strand within a clone? Usually false — HiFi can call
    // the same insertion from either side of a soft-clip.
    clonal_use_strand = false

    // RepeatMasker download + overlap
    repeatmasker_cache_dir  = "${projectDir}/refs/repeatmasker"

    // UCSC bigBed sources
    repeatmasker_url_t2t = "https://hgdownload.soe.ucsc.edu/gbdb/hs1/t2tRepeatMasker/chm13v2.0_rmsk.align.bb"
    repeatmasker_url_hg38 = "https://hgdownload.soe.ucsc.edu/hubs/RepeatBrowser2020/hg38/hg38_2020_rmsk.bed"

    // Skip the download + overlap entirely
    skip_repeatmasker  = false

    // single | multi | both   (default both: slim single-page + multi-page)
    html_mode = "both"

    // Which assembly to render against in circos. hg38 + t2t have built-in
    // chromosome length tables in make_circos.R; for any other assembly
    // supply a UCSC chrom.sizes file via params.cytoband_t2t.
    report_genome = "t2t" // or "hg38" 

    // Optional CHM13v2.0 cytoband / chrom-sizes file (path string).
    cytoband_t2t = null

    // Also run the legacy CREATE_HTML_REPORT alongside POST_PROCESS.
    // Default: false (POST_PROCESS supersedes it).
    legacy_project_html = false
}

// Define profiles for slurm execution environment
profiles {

    // SLURM System
    slurm {
        executor {
                queueSize = 47
                submitRateLimit = '20/1min'
                pollInterval = '30 sec'
                queueStatInterval = '2 min'
            }

        process {
            executor = 'slurm' // Use SLURM as the executor
            clusterOptions = "--partition=${params.partition} --oversubscribe" // SLURM partition, account
            cpus = "${params.threads}" // Number of threads per job
            memory = "${params.memory}" // Memory per job
            errorStrategy = 'ignore'

            // ----------------------------------------------------------------
            // Per-process resources & partition routing.
            // NOTE: every `withName:` selector lives INSIDE this `process { }`
            // block. Placing them at the profile scope makes Nextflow silently
            // ignore them, so all jobs end up on the default partition.
            // ----------------------------------------------------------------
            // ----- Read prep / QC ------------------------------------------
            withName: SIMULATE_READS { cpus = 16; memory = '8 GB'; time = '2h' }
            withName: TRIM_READS { cpus = 16; memory = '8 GB'; time = '2h' }
            withName: BAM_TO_FASTQ { cpus = 16; memory = '8 GB'; time = '2h' }
            withName: FASTQC  { cpus = 16; memory = '8 GB'; time = '2h' }
            withName: MULTIQC { cpus = 16; memory = '8 GB'; time = '2h' }
            withName: QUALIMAP { cpus = 8;  memory = '8 GB'; time = '2h' }

            // ----- Reference / annotation prep -----------------------------
            withName: GFFCONVERT {
                cpus = 2; memory = '2 GB'; time = '1h'
                executor = 'local'
            }

            // ----- Multi-reference + iterative viral mapping --------------
            // Routed to the LARGE partition (cpu1500g) to avoid OOM on cpu384g
            withName: MULTI_REFERENCE_MAPPING {
                clusterOptions = "--partition=${params.partition_large} --oversubscribe"
                cpus = 16; memory = '15 GB'; time = '2h'
            }
            withName: ITERATIVE_MAPPING {
                clusterOptions = "--partition=${params.partition_large} --oversubscribe"
                cpus = 16; memory = '15 GB'; time = '2h'
            }
            withName: SELECT_BEST_REFERENCE {
                clusterOptions = "--partition=${params.partition_large} --oversubscribe"
                cpus = 16; memory = '10 GB'; time = '2h'
            }

            // ----- Host-side mapping (memory-heavy) -----------------------
            withName: MAP_FLANKS_TO_HOST { cpus = 8; memory = '32 GB'; time = '4h' }
            withName: CONFIRM_HOST_ALIGNMENTS { cpus = 8; memory = '32 GB'; time = '4h' }

            // ----- Misc per-sample steps ----------------------------------
            withName: GENERATE_INTEGRATIONS { cpus = 4; memory = '8 GB'; time = '2h' }
            withName: COMBINE_RESULTS { cpus = 2; memory = '2 GB'; time = '1h' }
            withName: UNMASK_SEQUENCES { cpus = 4; memory = '4 GB'; time = '2h' }
            withName: EXTRACT_FLANKS { cpus = 2; memory = '4 GB'; time = '2h' }

            // ----- Annotation + legacy HTML -------------------------------
            withName: INTEGRATION_ANNOTATE { cpus = 4; memory = '8 GB'; time = '2h' }
            withName: CREATE_HTML_REPORT { cpus = 4; memory = '8 GB'; time = '2h' }

            // ----- Demux -------------------------------------------------
            withName: LIMA { cpus = 4; memory = '8 GB'; time = '4h' }
            withName: RENAME_DEMUXED_BAM {
                cpus = 1; memory = '1 GB'; time = '15m'
                executor = 'local'
            }

            // ----- RepeatMasker fetch + overlap ---------------------------
            withName: REPEATMASKER_DOWNLOAD {
                cpus = 1; memory = '2 GB'; time = '50m'
                executor = 'local'   // network access
            }
            withName: REPEATMASKER_OVERLAP { cpus = 1; memory = '2 GB'; time = '1h' }

            // ----- Post-processing (clonal IDs, circos, slim HTML) -------
            withName: ASSIGN_CLONAL_IDS { cpus = 1; memory = '4 GB'; time = '30m' }
            withName: CIRCOS_SAMPLE { cpus = 1; memory = '4 GB'; time = '30m' }
            withName: CIRCOS_PROJECT { cpus = 1; memory = '4 GB'; time = '30m' }
            withName: SAMPLE_HTML { cpus = 1; memory = '2 GB'; time = '30m' }
            withName: PROJECT_HTML { cpus = 1; memory = '2 GB'; time = '30m' }
        }
    }

    // Apptainer profile
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }

    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }

    // Test profile - minimal dataset
    test {
        params {
            // Run on subset sample
            //patient_fastq = "${projectDir}/data/test/subset_hiv.fq.gz"
	        patient_bam = "${projectDir}/data/test/92UG_029.subset.bam"
            //viral_genomes = "${projectDir}/data/hiv_genome_panal/*fasta"

            // Minimal resources
            threads = 4
            memory = '2 GB'
            outdir = "${projectDir}/test_results"
        }

        process {
            executor = 'local'
            cpus = 4
            memory = '2 GB'
            time = '1h'
            errorStrategy = 'terminate'
        }
    }

}

// ============================================================================
// REFACTOR ADDITIONS — top-level process directives that apply across profiles
// ----------------------------------------------------------------------------
// Container overrides:
//   - LIMA: pulled automatically from biocontainers via the module's container
//     directive. Override here only if your site mirrors images.
//   - All other new processes (REPEATMASKER_OVERLAP, ASSIGN_CLONAL_IDS,
//     CIRCOS_*, SAMPLE_HTML, PROJECT_HTML) call the R/bedtools tools that
//     already live in your existing SIFs — point them at params.container_R
//     (R-Genomics) or params.container as appropriate.
// ============================================================================
process {
    withName: LIMA {
        ext.args = { params.lima_args }
        ext.prefix = { "demux_${meta.id - 'demux_'}" }
    }

    // R-based post-processing → R-Genomics SIF
    withName: ASSIGN_CLONAL_IDS { container = params.container_R }
    withName: CIRCOS_SAMPLE { container = params.container_R }
    withName: CIRCOS_PROJECT { container = params.container_R }
    withName: SAMPLE_HTML { container = params.container_R }
    withName: PROJECT_HTML { container = params.container_R }

    // bedtools / kent-tools live in the main viral_int container
    withName: REPEATMASKER_DOWNLOAD { container = params.container }
    withName: REPEATMASKER_OVERLAP { container = params.container }
    withName: RENAME_DEMUXED_BAM { container = params.container }
}

// Manifest
manifest {
    name = 'HIV-SMRTCap-NF-Pipeline'
    author = 'Connor S. Murray, PhD'
    description = 'HIV integration detection pipeline using SMRTCap methodology with PacBio HiFi sequencing'
    nextflowVersion = '>=25.10.0' // any 25.10.x or newer (was '25.12.0-edge.10747')
    mainScript = 'main.nf'
}

// Nextflow Standard Run Reports
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

